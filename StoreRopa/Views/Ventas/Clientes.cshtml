@model StoreRopa.Models.utils.PagedResult<Persona>

@Html.AntiForgeryToken()
<table class="table table-bordered table-hover" id="dataTab">
    <thead class="thead-dark">
        <tr>
            <th>#</th>
            <th> @Html.DisplayName("Número de cliente")</th>
            <th> @Html.DisplayName("Nombre")</th>
            <th> @Html.DisplayName("Curp")</th>
            <th> @Html.DisplayName("Dirección")</th>
            <th> @Html.DisplayName("Tipo de venta")</th>
            <th> @Html.DisplayName("")</th>
        </tr>
    </thead>
    <tbody>
        @{
            var i = 1;
        }
        @foreach (var cliente in Model.Results)
        {
            var rowNo = (Model.CurrentPage - 1) * Model.PageSize + i;
            i++;
            <tr class="bus">
                <td>@rowNo</td>
                <td>@($"{cliente.Cliente.Id:D10}")</td>
                <td>@cliente.Nombres @cliente.ApPaterno @cliente.ApMaterno</td>
                <td>@cliente.Curp</td>
                <td>@cliente.Direccion</td>
                @if (@cliente.Cliente.TipoVenta == 1)
                {
                    <td>Contado</td>
                } else{
                    <td>Crédito</td>
                }
               
                <td>
                    <input type="checkbox" class="form-check-input chk" name="chkSeleccion" onclick="ValidaCheckCliente(this)" />
                </td>
            </tr>
        }
    </tbody>
</table>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_Clientes");
    }
}