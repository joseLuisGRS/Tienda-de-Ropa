@model StoreRopa.Models.Vo.AbonoVO
@{
    ViewData["Title"] = "Abonos";
}
<div class="row" id="divPrincipal">
    <form asp-action="GenerarAbono" id="frmAbono" onKeyPress="if (event.keyCode == 13) event.returnValue = false; ">
       <div class="row">
            <input type="hidden" id="txtExito" name="txtExito" value="@Html.ViewBag.Exito" />
            <input type="hidden" id="txtErrorMessage" name="txtErrorMessage" value="@Html.ViewData["error"]" />
            <div id="error" class="ui-state-error"></div>

            <div class="row g-3">
                <div class="col-sm">
                    <div class="form-outline">
                        <h1 class="justify-content-center">@Html.ViewData["Title"]</h1>
                    </div>
                </div>
                <div class="col-sm">
                    <div class="form-outline">
                        <label class="form-check-label">Tipo de búsqueda del cliente</label><br />
                        <input class="form-check-input"  type="radio" asp-for="TipoBusqueda" value="id" />
                        <label class="form-check-label">Clave cliente</label>
                        <input class="form-check-input"  type="radio" asp-for="TipoBusqueda" value="curp" />
                        <label class="form-check-label">Curp</label>
                        <input class="form-check-input"  type="radio" asp-for="TipoBusqueda" value="nombre" checked />
                        <label class="form-check-label">Nombre</label>                       
                    </div>
                </div>
                <div class="col-sm" id="divClaveCliente">
                    <div class="form-outline">
                        <br />
                        <input asp-for="ClaveCliente" class="form-control" id="txtClaveCliente" onkeypress="return validar('txtClaveCliente',10);"
                               onkeydown="return onlyNumbers(event);" />
                        <span asp-validation-for="ClaveCliente" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-sm" id="divCurp">
                    <div class="form-outline">
                        <br />
                        <input asp-for="Curp" class="form-control" onkeypress="return letrasNumeros(event);" onkeyup="this.value = upper(this.value)" />
                        <span asp-validation-for="Curp" class="text-danger"></span>
                    </div>
                </div>                
                 <div class="col-sm" id="divClientes">
                    <div class="form-outline">
                        <br />
                        <select class="form-select" asp-items="@((List<SelectListItem>)(ViewData["Clientes"]))" id="cliente"
                                asp-for="ClienteId" data-none-selected-text="Filter" data-live-search="true" data-container="body">
                            <option value="-1">Seleccione</option>
                        </select>
                        <span asp-validation-for="ClienteId" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-sm" id="divBtn">
                    <div class="form-outline">
                        <br />
                        <button type="button" class="btn btn-primary" id="btnConsultarCliente"> <i class="bi bi-search"></i>
                            Consultar</button>
                    </div>
                </div>
            </div>
            <div class="col-sm" id="divDatosAbono">
                <div class="row g-3">
                    <div class="col col-lg-2">
                        <div class="form-outline">
                            <label asp-for="AbonoClienteId" class="control-label"></label><br />
                            <label class="control-label" style="color:darkred ;" id="lblAbonoClienteId" />
                        </div>
                    </div>
                    <div class="col-sm">
                        <div class="form-outline">
                            <label asp-for="NombreCliente" class="control-label"></label><br />
                            <label id="lblNombreCliente" class="control-label" style="color:darkred ;" />
                        </div>
                    </div>
                    <div class="col col-lg-2">
                        <div class="form-outline">
                            <label asp-for="Saldo" class="control-label"></label>
                            <input asp-for="Saldo" class="form-control" id="txtSaldo" 
                                style="background-color:transparent;" readonly />
                            <span asp-validation-for="Saldo" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col col-lg-2">
                        <div class="form-outline">
                            <label asp-for="Abono" class="control-label"></label>
                            <input asp-for="Abono" class="form-control maskMoney" id="txtAbono"
                                   onkeypress="return validar('txtAbono',10)" style="background-color:transparent;"
                                   data-val-number="El Abono es incorrecto." />
                            <span asp-validation-for="Abono" id="spAbono" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col col-lg-2">
                        <div class="form-outline">
                            <label asp-for="PendientePago" class="control-label"></label>
                            <input asp-for="PendientePago" id="txtPendientePago" class="form-control" style="background-color:transparent;" readonly />
                            <span asp-validation-for="PendientePago" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="row g-3">        
                    <div class="col col-lg-6"></div>
                    <div class="col col-lg-2">
                        <div class="form-outline">
                            <label asp-for="CantidadRecibida" class="control-label"></label>
                            <input asp-for="CantidadRecibida" id="txtCantidadRecibida" class="form-control"
                                   onkeypress="return validar('txtCantidadRecibida',10)" onkeydown="return Decimal(this);"
                                   data-val-number="La cantidad recibida incorrecta." />
                            <span asp-validation-for="CantidadRecibida" id="spCantidadRecibida" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="col col-lg-4">
                        <div class="form-outline">
                            <br />
                            <button type="button" class="btn btn-outline-danger btn-sm ms-5 my-1" id="btnCancelar">
                                Cancelar<i class="bi bi-trash-fill"></i>
                            </button>
                            <button type="button" class="btn btn-outline-primary btn-sm my-1" id="btnAbonar">
                                Abonar <i class="bi bi-check2-circle"></i>
                            </button>
                        </div>
                    </div>

                </div>
                <br />
                <div class="row g-1">
                    <div class="col-sm">
                        <div class="form-outline">
                            <table class="table table-bordered table-hover" id="tablaArticulos">
                                <thead class="table-dark">
                                    <tr>
                                        <th>#</th>
                                        <th> @Html.DisplayName("Venta")</th>
                                        <th> @Html.DisplayName("Fecha")</th>
                                        <th> @Html.DisplayName("Total Venta")</th>
                                        <th> @Html.DisplayName("Abono")</th>
                                        <th> @Html.DisplayName("Por pagar")</th>
                                    </tr>
                                </thead>
                                <tbody>                                  
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<div id="myModal" class="modal " tabindex="-1" role="dialog"
     aria-hidden="true">
    <div class="modal-dialog modal-fullscreen">
        <div class="modal-content">
            <div class="modal-header bg-black justify-content-center">
                <h5 class="modal-title text-white" id="myModalLabel">Seleccionar Cliente</h5>
            </div>
            <div class="modal-body">
                <div id="modal-content">
                    Cargando...
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger close" data-dismiss="myModal">Cancelar <i class="bi bi-x-lg"></i></button>
                <button type="button" class="btn btn-primary" data-dismiss="myModal" id="btnSeleccionar">Seleccionar <i class="bi bi-check-circle-fill"></i></i></button>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/abonos/abonos.js"></script>
}
