@model StoreRopa.Models.Vo.RolesVO
@if (Model != null)
{
    <div class="row">
        <form asp-action="Edit" onKeyPress="if (event.keyCode == 13) event.returnValue = false; ">
            <div class="row">
                <input type="hidden" asp-for="roles.Id" />
                <input type="hidden" id="txtExito" name="txtExito" value="@Html.ViewBag.Exito" />
                <input type="hidden" id="txtErrorMessage" name="txtErrorMessage" value="@Html.ViewData["error"]" />
                <div id="error" class="ui-state-error"></div>
                <div class="row g-3">
                    <div class="col-sm">
                        <div class="form-outline">
                            <label asp-for="roles.Nombre" class="control-label"></label>
                            <input asp-for="roles.Nombre" class="form-control" onkeypress="return onlyLetras(event);" />
                            <span asp-validation-for="roles.Nombre" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-sm">
                        <div class="form-outline">
                            <label asp-for="roles.Descripcion" class="control-label"></label>
                            <input asp-for="roles.Descripcion" class="form-control" onkeypress="return onlyLetras(event);" />
                            <span asp-validation-for="roles.Descripcion" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>
        </form>

    </div>
}
@section Scripts {
    @{
        await Html.RenderPartialAsync("_Edit");
    }
}
