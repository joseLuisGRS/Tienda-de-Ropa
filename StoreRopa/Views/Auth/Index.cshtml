@model StoreRopa.Models.Vo.AuthVo
@{
    Layout = "/Views/Shared/_LoyoutLogin.cshtml";
    ViewData["Title"] = "Logín";
}
<section class="gradient-custom">
    <div class="container py-5">
        <div class="row d-flex justify-content-center align-items-center">
            <div class="col-12 col-md-8 col-lg-6 col-xl-5">
                <div class="card bg-dark text-white" style="border-radius: 1rem;">
                    <div class="card-body p-5 text-center">

                        <div class="mb-md-5 mt-md-4 pb-5">
                            <form asp-action="Auth" onKeyPress="if (event.keyCode == 13) event.returnValue = true; ">
                                @Html.AntiForgeryToken()
                                <span class="text-danger">@Html.ViewData["errorSesion"]</span>
                                <h2 class="fw-bold mb-2 text-uppercase">Login</h2>
                                <div data-mdb-input-init class="form-outline form-white mb-4">                                    
                                    <label asp-for="Usuario" class="control-label"></label>
                                    <input asp-for="Usuario" class="form-control" onkeypress="return onlyLetras(event);" />
                                    <span asp-validation-for="Usuario" class="text-danger"></span>
                                </div>

                                <div data-mdb-input-init class="form-outline form-white mb-4">
                                    <label asp-for="Password" class="control-label"></label>
                                    <input type="password" asp-for="Password" class="form-control" />
                                    <span asp-validation-for="Password" class="text-danger"></span>
                                </div>

                                <button data-mdb-button-init data-mdb-ripple-init class="btn btn-outline-light btn-lg px-5"
                                        type="submit">
                                    <i class="bi bi-person-check-fill"></i> Login
                                </button>
                            </form>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section scripts {
    <partial name="_ValidationScriptsPartial" />
}
